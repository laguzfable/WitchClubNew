  ability: []
  talk:
    battleStart:
    - "\u59b3\u770b\u5f97\u898b\u6211\u5728\u8aaa\u8a71\u3002\u90a3\u5c31\u5c0d\u4e86\u2014\u2014\u59b3\u662f\u5973\u5deb\u3002"
    act:
    - "\u7b2c\u4e00\u9801\uff1a\u4e00\u958b\u59cb\uff0c\u9019\u88e1\u53ea\u662f\u500b\u666e\u901a\u7684\u4e16\u754c\u3002"
    - "\u7b2c\u4e8c\u9801\uff1a\u5f8c\u4f86\u6709\u6771\u897f\u964d\u81e8\u4e86\u3002\u66f8\u4e0a\u5beb\u300c\u53e4\u795e\u300d\uff0c\u4f46\u90a3\u4e0d\u662f\u540d\u5b57\uff0c\u662f\u6c92\u4eba\u6562\u5beb\u540d\u5b57\u3002"
    - "\u7b2c\u4e09\u9801\uff1a\u7260\u4f86\u4e86\u4e4b\u5f8c\uff0c\u6df1\u6df5\u5c31\u4e0d\u518d\u53ea\u662f\u6df1\u6df5\u4e86\u3002"
    - "\u7b2c\u56db\u9801\uff1a\u5f9e\u88c2\u7e2b\u88e1\u6e67\u51fa\u4f86\u7684\u6771\u897f\uff0c\u53eb\u865b\u7a7a\u4e4b\u5f71\u3002"
    - "\u7b2c\u4e94\u9801\uff1a\u770b\u5f97\u898b\u5b83\u5011\u7684\u4eba\uff0c\u5f9e\u90a3\u5929\u8d77\u5c31\u6709\u4e86\u9b54\u529b\u3002\u770b\u4e0d\u898b\u7684\u4eba\uff0c\u4ec0\u9ebc\u4e5f\u6c92\u767c\u751f\u3002"
    - "\u7b2c\u516d\u9801\uff1a\u6240\u4ee5\u5973\u5deb\u4e0d\u662f\u88ab\u9078\u4e2d\u7684\u3002\u53ea\u662f\u525b\u597d\u770b\u898b\u4e86\u3002"
    - "\u7b2c\u4e03\u9801\uff1a\u770b\u4e0d\u898b\u7684\u4eba\u5f8c\u4f86\u627e\u5230\u4e86\u8fa6\u6cd5\u2014\u2014\u9644\u9b54\u7684\u6771\u897f\u3001\u9905\u4e7e\u3001\u8349\u3002"
    - "\u7b2c\u516b\u9801\uff1a\u90a3\u7a2e\u529b\u91cf\u662f\u501f\u4f86\u7684\u3002\u501f\u4f86\u7684\u6771\u897f\uff0c\u9072\u65e9\u8981\u9084\u3002"
    hurt:
    - "\u59b3\u770b\u5f97\u898b\u6211\uff0c\u537b\u8981\u628a\u6211\u6495\u6389\uff1f"
    - "\u9019\u4e00\u9801\u9084\u6c92\u8b80\u5b8c\u3002"
    lowHp:
    - "\u7b49\u7b49\u2014\u2014\u6700\u91cd\u8981\u7684\u90a3\u53e5\u5728\u6700\u5f8c\u2014\u2014"
    defeated:
    - "\u2026\u2026\u90a3\u4e9b\u5f71\u5b50\u9084\u5728\u5916\u9762\u3002\u5b83\u5011\u4e00\u76f4\u90fd\u5728\u3002"
