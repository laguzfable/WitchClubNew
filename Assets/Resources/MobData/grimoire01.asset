  talk:
    battleStart:
    - "\u7ffb\u958b\u4e86\u3002\u65e2\u7136\u7ffb\u958b\u4e86\uff0c\u5c31\u5f97\u8b80\u5b8c\u3002"
    act:
    - "\u7b2c\u4e00\u9801\u3002\u95dc\u65bc\u60e1\u9b54\u5973\u738b\uff0c\u8c61\u7259\u5854\u7684\u8a18\u8f09\u53ea\u6709\u4e00\u53e5\u2014\u2014\u300c\u5979\u4f86\u7684\u6642\u5019\uff0c\u5929\u662f\u7d05\u7684\u3002\u300d"
    - "\u7b2c\u4e8c\u9801\u3002\u90a3\u4e0d\u662f\u6bd4\u55bb\u3002\u90a3\u4e00\u5e74\u7684\u65e5\u843d\u6301\u7e8c\u4e86\u56db\u5341\u5929\u3002"
    - "\u7b2c\u4e09\u9801\u3002\u5979\u6c92\u6709\u653b\u6253\u4efb\u4f55\u5730\u65b9\u3002\u5979\u53ea\u662f\u554f\u4e86\u6bcf\u4e00\u500b\u5973\u5deb\u540c\u4e00\u500b\u554f\u984c\u3002"
    - "\u7b2c\u56db\u9801\u3002\u300c\u59b3\u9858\u610f\u7528\u4ec0\u9ebc\uff0c\u63db\u59b3\u60f3\u8981\u7684\u6771\u897f\uff1f\u300d"
    - "\u7b2c\u4e94\u9801\u3002\u56de\u7b54\u4e86\u7684\u4eba\uff0c\u5f8c\u4f86\u6210\u4e86\u7d50\u793e\u3002\u6c92\u6709\u56de\u7b54\u7684\u4eba\uff0c\u84cb\u4e86\u8c61\u7259\u5854\u3002"
    hurt:
    - "\u5225\u6025\uff0c\u9084\u6c92\u8b80\u5b8c\u3002"
    - "\u5f04\u58de\u6211\uff0c\u59b3\u5c31\u6c38\u9060\u4e0d\u6703\u77e5\u9053\u4e86\u3002"
    lowHp:
    - "\u7b49\u4e00\u4e0b\u2014\u2014\u6700\u5f8c\u4e00\u9801\u9084\u6c92\u2014\u2014"
    defeated:
    - "\u2026\u2026\u59b3\u9078\u64c7\u4e86\u4e0d\u77e5\u9053\u3002\u9019\u4e5f\u662f\u4e00\u7a2e\u56de\u7b54\u3002"
    actInOrder: 1
