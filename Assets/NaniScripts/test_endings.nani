@SaveReturnPoint script:"chapter4green" label:"greennight_v2"
@GotoUnityScene sceneName:NaniDialogTest

# setup_kachuu
@set affinity_Syb=0
@SaveReturnPoint script:"chapter4green" label:"greennight_s2"
@GotoUnityScene sceneName:NaniDialogTest

# goto_eclipse
@SaveReturnPoint script:"chapter5yellow" label:"eclipse"
@GotoUnityScene sceneName:NaniDialogTest

