@stopBgm
@back bg01
@hidePrinter

# page1
@choice "緋紅替身（ch5blue）" goto:.goto_end_crimson
@choice "純藍之冠（ch5blue）" goto:.goto_end_blue_crown
@choice "在妳身邊（ch6red）" goto:.goto_zaiyushenbian
@choice "穢血新神（ch6red）" goto:.goto_eupie_usurp
@choice "深春（ch4green）" goto:.goto_greennight_v2
@choice "火中の幻影（ch4green・需Syb<30）" goto:.setup_kachuu
@choice "輪迴の鑰匙（ch5yellow）" goto:.goto_eclipse
@choice "背棄世界（ch5yellow）" goto:.goto_realworld
@choice "小精靈，飛走了（ch5yellow）" goto:.setup_pixie
@choice "▼ 下一頁" goto:.page2
@stop

# page2
@choice "改寫命運（euphie_end）" goto:.goto_end1
@choice "殉道（badend01）" goto:.goto_end2
@choice "異端（badend12）" goto:.goto_badend12
@choice "唯一（badend13）" goto:.goto_badend13
@choice "壞滅（badend14）" goto:.goto_badend14
@choice "肅清（badend15）" goto:.goto_badend15
@choice "魔蝕（badend16）" goto:.goto_badend16
@choice "蘇生（badend17）" goto:.goto_badend17
@choice "終焉（ch5common）" goto:.goto_ch5end
@choice "墮星之主（ch6red・mel_end）" goto:.goto_mel_end
@choice "私奔（syb_end）" goto:.goto_syb_end
@choice "▼ 劇情段落" goto:.page3
@choice "▲ 上一頁" goto:.page1
@stop

; ── 第三頁：不是結局，是需要驗證的劇情段落 ──
; 劇情地圖要有解鎖紀錄才能用，這頁不用，直接跳。
# page3
@choice "第四章・分線抉擇（三選一＋薇狄亞攔截）" goto:.goto_ch4route
@choice "紅線・最終抉擇（兩段式二選一）" goto:.goto_finalred
@choice "梅爾線索日（redclue×3）" goto:.goto_redclue
@choice "▲ 回第一頁" goto:.page1
@stop

# goto_end_crimson
@SaveReturnPoint script:"chapter5blue" label:"end_crimson"
@GotoUnityScene sceneName:NaniDialogTest

# goto_end_blue_crown
@SaveReturnPoint script:"chapter5blue" label:"end_blue_crown"
@GotoUnityScene sceneName:NaniDialogTest

