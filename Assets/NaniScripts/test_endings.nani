@set affinity_Nel=50
@SaveReturnPoint script:"chapter5yellow" label:"realworld"
@GotoUnityScene sceneName:NaniDialogTest

# setup_pixie
@set affinity_Nel=100
@SaveReturnPoint script:"chapter5yellow" label:"success"
@GotoUnityScene sceneName:NaniDialogTest

